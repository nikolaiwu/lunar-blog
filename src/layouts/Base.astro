---
// Theme first, then its layout layer, then yours. Cascade layers are ordered
// by first appearance, so keep this order.
import "@nikolaiwu/lunarcss/fonts";
import "@nikolaiwu/lunarcss";
import "@nikolaiwu/lunarcss/layout";
import "../styles/site.css";

import Logo from "../assets/logo.svg";
import Seo, { type Props as SeoProps } from "../components/Seo.astro";
import { url } from "../lib/url";
import { siteConfig } from "../site.config";

// Astro pages pass the page's title, description and so on as props (see
// Seo.astro). Markdown pages that use this layout (e.g. about.md) pass their
// frontmatter instead, which can set a title and description.
interface Props extends SeoProps {
  frontmatter?: { title?: string; description?: string };
}

const { frontmatter, ...seo } = Astro.props;
if (frontmatter) {
  seo.title = frontmatter.title ?? seo.title;
  seo.description = frontmatter.description ?? seo.description;
}

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.title}
      href={new URL(url("rss.xml"), Astro.site)}
    />
    <link rel="sitemap" href={url("sitemap-index.xml")} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header>
      <a href={url()}>
        <Logo aria-hidden="true" /> <strong>{siteConfig.title}</strong>
      </a>
      <nav aria-label="Main">
        <ul>
          {siteConfig.nav.map((link) => {
            const href = url(link.href);
            return (
              <li>
                <a
                  href={href}
                  aria-current={
                    currentPath.startsWith(href) ? "page" : undefined
                  }
                >
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>
        <small>
          &copy; {new Date().getFullYear()} {siteConfig.author}
        </small>
      </p>
      <p>
        <small>
          Built with <a href="https://astro.build">Astro</a> and{" "}
          <a href="https://github.com/nikolaiwu/lunarcss">LunarCSS</a>
        </small>
      </p>
      <p>
        <small>
          <a href={url("rss.xml")}>RSS feed</a>
        </small>
      </p>
    </footer>
  </body>
</html>
