---
// A single post: title, dates, tags, hero image and content, then links to
// the neighbouring posts. The post is the only <article> in <main>, so
// LunarCSS leaves it plain instead of drawing it as a card.
import { Image } from "astro:assets";
import FormattedDate from "../components/FormattedDate.astro";
import { url } from "../lib/url";
import type { Post } from "../lib/posts";
import Base from "./Base.astro";

interface Props {
  post: Post;
  // The next post by date, and the previous one
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
---

<Base
  title={title}
  description={description}
  image={heroImage}
  imageAlt={post.data.heroImageAlt}
  article={{ published: pubDate, modified: updatedDate, tags }}
>
  <article>
    <header>
      <h1>{title}</h1>
      {/* One line of metadata straight in the header, not a <p>: a paragraph
          gets the theme's bracket and reads as the start of the post */}
      <small>Published</small> <FormattedDate date={pubDate} />
      {updatedDate && (
        <>
          {" · "}
          <small>Updated</small> <FormattedDate date={updatedDate} />
        </>
      )}
      {tags.length > 0 && (
        <>
          {" · "}
          <small>Tagged</small>{" "}
          {tags.map((tag, i) => (
            <>
              {i > 0 && ", "}
              <a href={url(`tags/${tag}/`)}>{tag}</a>
            </>
          ))}
        </>
      )}
    </header>

    {heroImage && (
      <Image
        src={heroImage}
        alt={post.data.heroImageAlt ?? ""}
        widths={[640, 1120, 2240]}
        sizes="(min-width: 72rem) 70rem, calc(100vw - 2rem)"
        priority
      />
    )}

    <slot />
  </article>

  {/* The theme's dotted band between the post and the links to its
      neighbours */}
  {(newer || older) && (
    <>
      <hr />
      <nav aria-label="More posts">
        <ul>
          {newer && (
            <li>
              Newer: <a href={url(`posts/${newer.id}/`)}>{newer.data.title}</a>
            </li>
          )}
          {older && (
            <li>
              Older: <a href={url(`posts/${older.id}/`)}>{older.data.title}</a>
            </li>
          )}
        </ul>
      </nav>
    </>
  )}
</Base>
