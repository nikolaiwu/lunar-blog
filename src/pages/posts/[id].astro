---
// One page per post, at /posts/<id>/. getPosts() is newest first, so a
// post's newer neighbour is the one before it and its older one the next.
import { render } from "astro:content";
import Post from "../../layouts/Post.astro";
import { getPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Post post={post} newer={newer} older={older}>
  <Content />
</Post>
