{
  "name": "lunar-blog",
  "version": "0.0.1",
  "private": true,
  "description": "A minimal Astro blog starter styled with LunarCSS, a classless CSS theme.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro"
  },
  "author": "Nikolai Vuchkov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikolaiwu/lunar-blog.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@nikolaiwu/lunarcss": "^0.1.1",
    "astro": "^7.3.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sass": "^1.105.0",
    "typescript": "^6.0.3"
  }
}
